@echo off
title BẢNG ĐIỀU KHIỂN STM32 PC13
powershell -NoProfile -ExecutionPolicy Bypass -Command "Add-Type -AssemblyName System.Windows.Forms; Add-Type -AssemblyName System.Drawing; $f=New-Object Windows.Forms.Form; $f.Text='ĐIỀU KHIỂN ĐÈN PC13 STM32'; $f.Size=New-Object Drawing.Size(420,260); $f.StartPosition='CenterScreen'; $f.FormBorderStyle='FixedDialog'; $f.MaximizeBox=$false; $lbl=New-Object Windows.Forms.Label; $lbl.Text='CỔNG KẾT NỐI: COM21 (STM32 USB MICRO)'; $lbl.Location=New-Object Drawing.Point(30,20); $lbl.Size=New-Object Drawing.Size(350,30); $lbl.Font=New-Object Drawing.Font('Arial',11,[Drawing.FontStyle]::Bold); $f.Controls.Add($lbl); $status=New-Object Windows.Forms.Label; $status.Text='Trạng thái: Sẵn sàng điều khiển'; $status.Location=New-Object Drawing.Point(30,50); $status.Size=New-Object Drawing.Size(350,25); $status.Font=New-Object Drawing.Font('Arial',10); $f.Controls.Add($status); function SendCmd($c, $msg, $color) { try { $p=New-Object System.IO.Ports.SerialPort 'COM21',9600; $p.DtrEnable=$true; $p.RtsEnable=$true; $p.Open(); $p.Write($c); Start-Sleep -m 150; $p.Close(); $status.Text=$msg; $status.ForeColor=$color; } catch { $status.Text='Lỗi: ' + $_.Exception.Message; $status.ForeColor=[Drawing.Color]::Red; } }; $btnOn=New-Object Windows.Forms.Button; $btnOn.Text='💡 BẬT ĐÈN PC13'; $btnOn.Location=New-Object Drawing.Point(40,90); $btnOn.Size=New-Object Drawing.Size(150,60); $btnOn.Font=New-Object Drawing.Font('Arial',11,[Drawing.FontStyle]::Bold); $btnOn.BackColor=[Drawing.Color]::FromArgb(46,204,113); $btnOn.ForeColor=[Drawing.Color]::White; $btnOn.Add_Click({ SendCmd '1' '>>> ĐÃ BẬT SÁNG ĐÈN LED PC13! <<<' ([Drawing.Color]::Green) }); $f.Controls.Add($btnOn); $btnOff=New-Object Windows.Forms.Button; $btnOff.Text='⚫ TẮT ĐÈN PC13'; $btnOff.Location=New-Object Drawing.Point(210,90); $btnOff.Size=New-Object Drawing.Size(150,60); $btnOff.Font=New-Object Drawing.Font('Arial',11,[Drawing.FontStyle]::Bold); $btnOff.BackColor=[Drawing.Color]::FromArgb(231,76,60); $btnOff.ForeColor=[Drawing.Color]::White; $btnOff.Add_Click({ SendCmd '0' '>>> ĐÃ TẮT ĐÈN LED PC13! <<<' ([Drawing.Color]::DarkRed) }); $f.Controls.Add($btnOff); [Windows.Forms.Application]::Run($f);"
